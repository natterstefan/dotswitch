{
  "name": "dotswitch",
  "version": "1.3.0",
  "description": "Quickly switch between .env files",
  "type": "module",
  "bin": {
    "dotswitch": "dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && mv dist/cli.mjs dist/cli.js && mv dist/cli.d.mts dist/cli.d.ts",
    "dev": "tsx src/cli.ts",
    "format": "biome format --write src tests",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dotswitch",
    "env",
    "dotenv",
    "env-switch",
    "env-files",
    "env-management",
    "environment",
    "environment-variables",
    "configuration",
    "cli",
    "nextjs",
    "vite",
    "remix",
    "monorepo",
    "devtools",
    "developer-tools",
    "git-hooks"
  ],
  "author": "Stefan Natter <https://natterstefan.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natterstefan/dotswitch.git"
  },
  "bugs": {
    "url": "https://github.com/natterstefan/dotswitch/issues"
  },
  "homepage": "https://github.com/natterstefan/dotswitch#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/select": "^4.1.0",
    "commander": "^13.1.0",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^22.13.4",
    "memfs": "^4.17.0",
    "tsdown": "^0.20.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
